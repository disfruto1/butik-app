DATABASE_URL=postgresql+psycopg2://kullanici:sifre@localhost/butik_db
# Zorunlu. Uretmek icin: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=buraya-uzun-ve-gizli-bir-anahtar-yaz
ALGORITHM=HS256
# Mobil uygulamada yenileme (refresh) token'i henuz yok, bu yuzden 1 gun (1440 dk) birakildi
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Sadece web icin gerekli, virgulle ayirin. Bos birakilirsa yerel gelistirme adresleri kullanilir
ALLOWED_ORIGINS=
# Siparis sonrasi musteriye gosterilen odeme bilgisi (havale/EFT). Bos birakilabilir.
ODEME_BILGISI=Havale/EFT ile odeme: TR00 0000 0000 0000 0000 0000 00 - Ad Soyad. Aciklamaya siparis numarasini yazin.
