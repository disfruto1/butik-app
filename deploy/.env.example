# Sunucuda bu dosyayi deploy/.env olarak kopyalayip doldurun. .env repoya GIRMEZ, sohbete de yazmayin.
# Degerlerde $ isareti kullanmayin (Docker Compose degisken sanar).

# Backend'in adresi. Bu adresin DNS kaydi sunucuya bakmali.
ALAN_ADI=api.yulamoda.com

# Uretmek icin: openssl rand -hex 24
POSTGRES_PASSWORD=
# Zorunlu. Uretmek icin: openssl rand -hex 48 (yerel .env'dekini KULLANMAYIN)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Mobil uygulama icin gerekmez, yalnizca web istemcisi olursa doldurun
ALLOWED_ORIGINS=

# Sifre sifirlama e-postalari (Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_KULLANICI=resend
SMTP_SIFRE=
SMTP_GONDEREN="Yula Moda <destek@yulamoda.com>"
# Yayinda bos kalmali
EPOSTA_KONSOLA_YAZ=

# PayTR. Ilk uc deger bos ise kart odemesi kapali olur.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_DONUS_ADRESI=https://api.yulamoda.com
# 1 iken para alinmaz AMA siparis "odendi" olur. Gercek satisa baslarken 0 yapin.
PAYTR_TEST_MODU=1
PAYTR_MAX_TAKSIT=1
# Yayinda bos kalmali
PAYTR_YEREL_IP=

# Havale/EFT bilgisi: gercek IBAN'inizi yazin
ODEME_BILGISI=
